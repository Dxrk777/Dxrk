# Dxrk — ejemplo de variables de entorno. Copiar a `.env` (nunca commitear).
# Valores de ejemplo; ajustar según el entorno local.

# Tenant activo por defecto (equivale a `dxrk-py --tenant <id>`).
DXRK_TENANT=

# Override de la versión mostrada por `--version` (por defecto, la de `pyproject.toml`).
DXRK_VERSION=

# Secreto para firmar/validar JWTs de tenant (NO commitear el valor real).
DXRK_JWT_SECRET=

# Clave maestra del vault (`dxrk/vault/`). Sin esto el vault es efímero.
DXRK_VAULT_KEY=

# Ruta del palace de memoria (por defecto `~/.dxrk/memory`).
DXRK_MEMORY_PATH=

# Intérprete Python usado por los hooks (debe ser el mismo o estar dentro del prefix actual).
DXRK_PYTHON=

# Binario de opencode usado por el backend del TUI chat.
DXRK_OPENCODE_BIN=

# Desactiva el self-update (1 = desactivado).
DXRK_NO_SELF_UPDATE=
